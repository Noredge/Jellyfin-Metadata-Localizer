<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.11.0-preview.1</Version>
    <AssemblyVersion>0.11.0.0</AssemblyVersion>
    <FileVersion>0.11.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>

    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/Localizer.Translation/Localizer.Translation.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Localizer.Plugin/ServiceSettingsStore.cs" Link="Product/ServiceSettingsStore.cs" />
    <Compile Include="../../src/Localizer.Plugin/ProviderCredential.cs" Link="Product/ProviderCredential.cs" />
    <Compile Include="../../src/Localizer.Plugin/OpenAiCredential.cs" Link="Product/OpenAiCredential.cs" />
    <Compile Include="../../src/Localizer.Plugin/GroqCredential.cs" Link="Product/GroqCredential.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../resources/title-rules.zh-Hans.json" Link="title-rules.zh-Hans.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../resources/title-rules.en.json" Link="title-rules.en.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
