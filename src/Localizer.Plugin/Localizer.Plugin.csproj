<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.12.0-preview.1</Version>
    <AssemblyVersion>0.12.0.0</AssemblyVersion>
    <FileVersion>0.12.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Localizer.Core/Localizer.Core.csproj" />
    <ProjectReference Include="../Localizer.Translation/Localizer.Translation.csproj" />
    <ProjectReference Include="../Localizer.Jellyfin/Localizer.Jellyfin.csproj" />
    <ProjectReference Include="../Localizer.Unified/Localizer.Unified.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Web/unified.html" />
    <EmbeddedResource Include="../../resources/title-rules.zh-Hans.json" LogicalName="Localizer.Rules.zh-Hans.json" WithCulture="false" />
    <EmbeddedResource Include="../../resources/title-rules.en.json" LogicalName="Localizer.Rules.en.json" WithCulture="false" />
    <PackageReference Include="Jellyfin.Common" Version="12.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Data" Version="12.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
